# Copy to .env for local development. Matches deploy/compose.yaml.
CARTEIRO_DATABASE_URL=postgres://carteiro:carteiro@localhost:5432/carteiro?sslmode=disable
# Development only. In production use a random value: openssl rand -hex 32
CARTEIRO_ADMIN_TOKEN=dev-admin-token-change-me-0123456789
CARTEIRO_HTTP_ADDR=:8080
CARTEIRO_LOG_LEVEL=debug
CARTEIRO_SHUTDOWN_TIMEOUT=15s
