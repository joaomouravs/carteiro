# Copy to .env for local development. Matches deploy/compose.yaml.
CARTEIRO_DATABASE_URL=postgres://carteiro:carteiro@localhost:5432/carteiro?sslmode=disable
# Development only. In production use a random value: openssl rand -hex 32
CARTEIRO_ADMIN_TOKEN=dev-admin-token-change-me-0123456789
# Development only. In production: openssl rand -base64 32, kept out of the repository.
CARTEIRO_ENCRYPTION_KEY=O8/tj+OGJr/LS/NtwE200Ubox90bcg3mHHEp/6yq4Nw=
# Accept http:// endpoint URLs, so receivers running on localhost work.
CARTEIRO_ALLOW_HTTP_ENDPOINTS=true
# Let endpoints point at localhost and private networks. Never in production:
# it would let producers reach internal services (SSRF).
CARTEIRO_ALLOW_PRIVATE_NETWORKS=true
CARTEIRO_HTTP_ADDR=:8080
CARTEIRO_LOG_LEVEL=debug
CARTEIRO_SHUTDOWN_TIMEOUT=15s
