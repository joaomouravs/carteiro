# Copy to .env.local for `npm run dev`.
# Where Carteiro's API is, as seen from the dashboard's server.
CARTEIRO_API_URL=http://localhost:8080
# Encrypts the session cookie that holds the API key. At least 32 random
# characters: openssl rand -base64 32. Changing it signs everyone out.
SESSION_SECRET=dev-session-secret-change-me-0123456789
